# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG TRÊN VERCEL & GITHUB
# ==============================================================================
#
# Khi bạn đưa source code lên GitHub và kết nối với Vercel:
# 1. Mở trang quản trị dự án trên Vercel: https://vercel.com/dashboard
# 2. Chọn dự án của bạn -> Chuyển sang tab "Settings" -> Chọn "Environment Variables"
# 3. Thêm biến môi trường sau:
#      - Key: GEMINI_API_KEY
#      - Value: <Dán mã khóa API Gemini của bạn tại đây>
# 4. Tích chọn đầy đủ: Production, Preview, Development.
# 5. Nhấn "Save" và tiến hành Redeploy dự án.
#
# ==============================================================================

# GEMINI_API_KEY: Khóa Google Gemini API Key dùng cho Serverless Function / Backend trên Vercel.
# Lấy khóa miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: (Tùy chọn) Dự phòng cho client-side Vite nếu bạn chạy hoàn toàn tĩnh.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL triển khai của ứng dụng (Tự động điền trên Cloud Run hoặc Vercel)
APP_URL="MY_APP_URL"
